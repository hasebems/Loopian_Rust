// ============================================
// Minimal Phase - ミニマル・ミュージック for Loopian
// スティーヴ・ライヒ風: ループ長の異なるパターンが
// ポリメトリックに位相ずれを起こす構成
// ============================================
// 使い方:
//   1. このファイルを load フォルダに置く
//   2. !l.minimal_phase でロード
//   3. !p で転送
//   4. play で再生開始(以降 !msr 行が自動転送される)
// ============================================

clear
set.bpm(138)
set.meter(4/4)
set.key(E4)
graph.dark
graph.title(Minimal Phase,for Loopian)

// 全パート: リディアンスケールによる浮遊感のあるモーダル空間
ALL.{lydian}

// --- [1小節目-] L1: ベース・オスティナート(1小節ループ) ---
L1.[e-d,s,+d,s,m,s,+d,s].dyn(mp)

// --- [9小節目-] R1: 8分音符パターン(3小節ループ) ---
!msr(9)
R1.[ed,r,m,s,l,s,m,r/ed,r,m,s,l,s,m,r/em,s,l,+d,l,s,m,r].dyn(mp)

// --- [17小節目-] R2: 同系パターン(4小節ループ) ---
// R1=3小節 x R2=4小節 → 12小節周期で位相が一巡する
!msr(17)
R2.[em,s,l,+d,t,l,s,m/em,s,l,+d,t,l,s,m/es,l,t,+d,t,l,s,m/el,s,m,r,m,s,l,t].dyn(p)

// --- [33小節目-] L2: ゆっくりした和音の層を追加 ---
!msr(33)
L2.[hCls(h,3,0),hCls(h,3,2)].dyn(pp)

// --- [41小節目-] 強弱の波: R1を少し前に出す ---
!msr(41)
R1.dyn(mf)

// --- [49小節目-] モーダル・シフト: ドリアンへ ---
!msr(49)
ALL.{dorian}

// --- [57小節目-] R2を前に、R1を奥に(音量の入れ替え) ---
!msr(57)
R1.dyn(p)

!msr(58)
R2.dyn(mf)

// --- [65小節目-] リディアンに回帰 ---
!msr(65)
ALL.{lydian}

// --- [73小節目-] 減衰: 層を少しずつ剥がしていく ---
!msr(73)
R1.dyn(pp)

!msr(75)
R2.dyn(pp)

!msr(77)
clear.L2

// --- [81小節目-] 終結: ベースのみ残し、ritして終わる ---
!msr(81)
clear.R1

!msr(82)
clear.R2

!msr(85)
rit.molto.bar(2)

!msr(87)
fine
