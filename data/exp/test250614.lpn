[]
R1
[ex,-d,m^,d,ex,t,ri^,t].dyn(pp)
R2
[-vl......,t^,l......,t^].dyn(p)
{O}

!msr(4)
L1
[qm,x,ri,x].dyn(p)
R1
[ex,-d,+s^,-d,ex,d,fi^,d].dyn(pp)
R2
