!blk(rain)
clear
set.bpm(56)
graph.rain
set.input(closer)
R1
[-ef,+d,qf%..].dyn(pp)
@1=[-ef,+d,qf%.,-srs].dyn(pp)
@2=[lmlo].dyn(ppp)
R2
[+et^,-m,qt..].dyn(pp)
@1=[+et^,-m,qt.,lml].dyn(pp)
@2=[tmto].dyn(pp)
ALL.{O/O/O@1/O@2}
play

!blk(fish)
clear
graph.fish
set.bpm(80)
R2
[+vs^,f,m%,r,d^,r,m%,f].rpt(2).dyn(mp)
R1
[+hst,-ms/st,-ms/ld,-ml/ld,-ml].dyn(p)
L2
[em^,s,l,d%,mo%].dyn(mp)
{IM7/IM7/IVM7/IVM7}
play
